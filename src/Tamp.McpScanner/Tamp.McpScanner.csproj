<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Tamp.McpScanner</RootNamespace>
    <AssemblyName>Tamp.McpScanner</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Tamp.McpScanner</PackageId>
    <Description>Tamp wrapper for Cisco's mcp-scanner. Scans MCP servers (remote, static tool manifest, or config file) for tool-poisoning / prompt-injection / credential-harvesting and related threats, and normalises the scanner's JSON into SARIF 2.1.0 so MCP findings flow through the Tamp security chain (merge, dedup, DefectDojo/Dependency-Track push, tamp-findings). Offline analyzers (yara, readiness, prompt_defense) by default; LLM/vendor analyzers are opt-in. Findings are about advertised tools, not files — they carry SARIF logicalLocations, not synthesised paths. Noisy by nature: intended as nightly, non-blocking evidence, not a per-push gate. Requires the Cisco mcp-scanner CLI on the machine that runs the scan.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      The Tamp code is MIT, but the nupkg also embeds the YARA rule packs, which are
      derived from Cisco's mcp-scanner and stay under Apache-2.0 (see NOTICE). The
      expression says so, and NOTICE ships in the package as Apache-2.0 section 4(d) requires.
    -->
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup Label="Package files">
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup Label="Tamp dependencies (dual-mode — see Directory.Build.props)">
    <ProjectReference Include="$(TampCorePath)" Condition="'$(TampCoreMode)' == 'project'" />
    <PackageReference Include="Tamp.Core" Condition="'$(TampCoreMode)' == 'package'" />
    <ProjectReference Include="$(TampSarifPath)" Condition="'$(TampCoreMode)' == 'project'" />
    <PackageReference Include="Tamp.Sarif" Condition="'$(TampCoreMode)' == 'package'" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!--
    Stack-aware rule packs ship inside the assembly as embedded resources and are
    materialised to a temp directory at runtime (Cisco's rules-path flag wants a
    directory). This works identically from a project reference or the published
    nupkg, with no contentFiles packaging quirks. See StackRules + docs/stack-rules.md.
  -->
  <ItemGroup Label="Rule packs">
    <EmbeddedResource Include="rules/**/*.yara" />
    <EmbeddedResource Include="rules/**/*.yar" />
    <EmbeddedResource Include="rules/**/*.rego" />
  </ItemGroup>

</Project>
