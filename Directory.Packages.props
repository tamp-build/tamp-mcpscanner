<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Test stack">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup Label="Source link">
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>

  <!--
    Tamp.Core / Tamp.Sarif 1.17.5 is a deliberate floor, not "whatever was current":
    - Tamp.Sarif 1.17.5 is the first release with the SARIF logicalLocations API
      (tamp#114) that CiscoSarifMapper needs.
    - Tamp.Sarif ships in lockstep with Tamp.Core and depends on Tamp.Core >= its own
      version, so Tamp.Core cannot sit below 1.17.5 without an NU1605 downgrade.
    - Nothing here needs anything newer. The code builds and its tests pass against
      1.18.0 too, so consumers on 1.18.x float up without conflict. Don't raise this
      without a concrete API need (an inflated floor caused NU1605 in tamp#119).
    The pins below these two (Tamp.NetCli.V10, Tamp.Components*, Tamp.Telegram) are
    only for the build/Build.csproj script and never reach the nupkg.
  -->
  <ItemGroup Label="Tamp packages">
    <PackageVersion Include="Tamp.Core" Version="1.17.5" />
    <PackageVersion Include="Tamp.Sarif" Version="1.17.5" />
    <PackageVersion Include="Tamp.NetCli.V10" Version="1.17.5" />
    <PackageVersion Include="Tamp.Components" Version="1.17.5" />
    <PackageVersion Include="Tamp.Components.NetCli.V10" Version="1.17.5" />
    <PackageVersion Include="Tamp.Telegram" Version="0.1.0" />
  </ItemGroup>

</Project>
